{
  "name": "coach-murray-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "corepack pnpm build && playwright test",
    "test:watch": "vitest",
    "provision:coach": "node scripts/provision-coach.mjs",
    "verify": "corepack pnpm check && corepack pnpm test && corepack pnpm build",
    "format": "prettier --write client netlify shared tests *.json *.ts *.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.0.0",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "wouter": "^3.7.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@netlify/functions": "^4.2.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
